u = import "std/utils.comb"

Sequence[ItemType] = {
	stringify: (ItemType) -> String,
	items: ItemType[],
	generate: (ItemType[]) -> ItemType,
}

Sequences = OrderedHashMap[String, scope(Sequence[Scoped])]

run_command = |sequences: Sequences| -> \Continue: Sequences, :Quit\ {
	command = readline("Enter the name of a sequence to expand or `quit` to quit: ")
	if command == "quit" {
		return :Quit
	}
	if command in sequences {
		return Continue: (sequences ~ [command] |= |sequence: scope(Sequence[Scoped])| -> scope (Sequence[Scoped]) {
			s = unscope(sequence, SequenceItem)
			return scope(Sequence[Scoped], SequenceItem, s ~ .items = s.items :: s.generate(s.items))
		})
	} else {
		println("`" & command & "` is not one of the sequences")
		return run_command(sequences)
	}
}

show_sequences = |sequences: Sequences| {
	for name, sequence in sequences {
		print(name & ": ")
		re first_item$ = true
		s = unscope(sequence, SequenceItem)
		for item in s.items {
			if first_item$ == false {
				print(", ")
			}
			print(s.stringify(item))
			first_item$ = false
		}
		print("\n")
	}
}

FaceSmile = \:Bracket, :SquareBracket\
FaceEyes = \:Colon, :Semicolon\
FaceOrientation = \:SmileFirst, :EyesFirst\
Face = {
	smile: FaceSmile,
	eyes: FaceEyes,
	orientation: FaceOrientation,
}
FaceSequenceItem = {
	num: UInt, // 0-3 inclusive
	decreasing: Bool,
}

render_eyes = |eyes: FaceEyes| -> String {
	match eyes {
		:Colon { return ":" }
		:Semicolon { return ";" }
	}
}

render_face = |face: Face| -> String {
	eyes = render_eyes(face.eyes)
	match face.orientation {
		:SmileFirst {
			match face.smile {
				:Bracket { return "(" & eyes }
				:SquareBracket { return "[" & eyes }
			}
		}
		:EyesFirst {
			match face.smile {
				:Bracket { return eyes & ")" }
				:SquareBracket { return eyes & "]" }
			}
		}
	}
}

main = || -> Int {
	uint_to_str = |v: UInt| -> String {
		return v.to_str
	}
	re sequences$ = u.as[Sequences](OrderedHashMap(
		"fibonacci" = scope(Sequence[Scoped], UInt, {
			stringify = uint_to_str,
			items = [1, 1],
			generate = |i: UInt[]| -> UInt {
				return i[i.len-2] + i[i.len-1]
			}
		}),
		"factorial" = scope(Sequence[Scoped], UInt, {
			stringify = uint_to_str,
			items = [1],
			generate = |i: UInt[]| -> UInt {
				return i[i.len-1] * (i.len + 1)
			}
		}),
		"faces" = scope(Sequence[Scoped], FaceSequenceItem, {
			stringify = |i: FaceSequenceItem| -> String {
				return render_face({
					smile = u.branch[FaceSmile](i.num % 2 == 0, :Bracket, :SquareBracket),
					eyes = u.branch[FaceEyes](i.num % 4 <= 1, :Colon, :Semicolon),
					orientation = u.branch[FaceOrientation](i.decreasing, :SmileFirst, :EyesFirst),
				})
			},
			items = [{num = 0, decreasing = false}],
			generate = |i: FaceSequenceItem[]| -> FaceSequenceItem {
				last = i[i.len - 1]
				if last.decreasing {
					if last.num == 0 {
						return {num = 0, decreasing = false}
					}
					return {num = expect_uint(last.num - 1), decreasing = true}
				} else {
					if last.num == 3 {
						return {num = 3, decreasing = true}
					}
					return {num = last.num + 1, decreasing = false}
				}
			}
		})
	))
	while true {
		show_sequences(sequences$)
		match run_command(sequences$) {
			:Quit { return 0 }
			Continue: new_sequences {
				sequences$ = new_sequences
			}
		}
	}
}
