//                                           Implemented in the programming language
//                                                         |--|
//                                                         |  |
//            state -> ui -> html -> event -> state updater -> new state
//                 |  |  |                   |
//                 |  |  |-------------------|
//                 |  |    Implemented in JS
//                 |--|
// Implemented in the programming language 

u = import "./utils.code"

Type = UInt

HashMap[Key, Value] = OrderedHashMap[Key, Value] // Maybe we should support non-ordered hash maps

TypeInfo = \
    Struct: OrderedHashMap[String, Type],
    SumType: OrderedHashMap[String, u.Maybe[Type]],
    OrderedHashMap: {key: Type, value: Type},
    Array: {length: u.Maybe[UInt], item_type: Type},
    Builtin: \\, // TODO
\

get_with_fallback[K, V] = |map: HashMap[K, V], key: K, fallback: V| -> V {
    if key in map {
        return map[key]
    }
    return fallback
}

walk_type = |t: Type, prefix: String, map$: HashMap[Type, String]| -> HashMap[Type, String[]] {
    // map$ = map$ ~ [t] = get_with_fallback[Type, String](map$, t, []) :: prefix
    match get_type_info(t) {
        Struct: fields {
            for field_name, field_type in fields {
                map$ = walk_type(field_type, prefix & "." & field_name, map$)
            }
        }
        SumType: variants {
            for variant_name, payload in variants {
                match payload {
                    :None {}
                    Some: p {
                        map$ = walk_type(p, prefix & ":" & variant_name, map$)
                    }
                }
            }
        }
        OrderedHashMap: m {
           map$ = walk_type(m.key, prefix & "(key)", map$)
           map$ = walk_type(m.value, prefix & "(value)", map$)
        }
        Array: a {
            map$ = walk_type(a.item_type, prefix & "[]", map$)
        }
        Builtin: b {
            eprintln("todo")
        }
    }
}

get_type_info = |t: Type| -> TypeInfo {
    
}

update_state[NewState] = |state_with_old_type: Any, default_state: NewState| -> NewState {
    if type_of(state_with_old_type) == NewState {
        return state_with_old_type
    }

    old_type_walked = walk_type(type_of(state_with_old_type), "", OrderedHashMap())
    new_type_walked = walk_type(type_of(NewState), "", OrderedHashMap())

    match get_type_info(NewState) {
        Struct: s {
            if s.fields.len == 0 {
                return {}
            } else if s.fields.len == 1 {
                
            }
        }
    }
}

h = import "http.code"
p = import "path.code"

SvgElem = \
    Line: {
        x1: UInt,
        y1: UInt,
        x2: UInt,
        y2: UInt,

        stroke_width: UInt,
        stroke_color: String,
    },
\

HtmlElem = \
    Button: {children: HtmlElem[], onclick: () -> UI},
    Div: {style: String, children: HtmlElem[]},
    Text: String,
    Svg: {style: String, width: UInt, height: UInt, contents: SvgElem[]},
\

Key = {
    key: String,
}

UI = {
    page_title: String,
    ui_contents: HtmlElem[],
    on_key_down: (Key) -> UI,
}

Site = {
    // TODO: Use `UI` rather than `() -> UI`
    // Currently this isn't useful because you can't interpret a call to a
    // render function like `(State) -> UI` at compile time so using `UI` rather
    // than `() -> UI` would make it impractical to construct a compile-time
    // known `Site`
    pages: OrderedHashMap[String, () -> UI], // TODO: Be able to use a unordered hash map
}

reactive_page = |c: Compiler, ui: () -> UI, kind: \:Dev, :Prod\| -> String {
    re glue$ = #load "./html.js"
    match kind {
        :Dev {glue$ = glue$ & "\n" & #load "./reload.js"}
        :Prod {}
    }
    // TODO: Be able to define the map something like `{"ui": ui()}`
    map = OrderedHashMap("ui" = ui())
    // TODO: Add minification:
    // - Maybe there could be an argument with the type
    //   `\:Minify, :LeaveNames\` in the future
    // - Alternatively, named arguments and default arguments could be added so
    //   the type of emit_js_code is
    //   `(OrderedHashMap[String, Any], String, minify = true)`, and then you
    //   call it like `emit_js_code(map, glue, minify = true)`
    js = c.emit_js_code(map, glue$)
    // The close tags are split up so that the browser interprets them as JS strings rather than HTML close tags
	// TODO: JS should be tree-shaked so the `reactive_page` function shouldn't even be included in the emitted JS code
    return
        "<!DOCTYPE html>" &
        "<html lang=\"en\">" &
            "<head>" &
                "<meta charset=\"UTF-8\" />" &
                "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">" &
                "<script>" & js & "</" & "script>" &
            "</" & "head>" &
            "<body></" & "body>" &
        "</" & "html>"
}

build_reactive_site = |c: Compiler, s: Site, path: String| {
    for rel_page_path, ui in s.pages {
        page_path = path & "/" & p.normalize_path(rel_page_path) & ".html"
        make_dir_all(p.dir(page_path))
        write_file(page_path, reactive_page(c, ui, :Prod))
    }
}

// TODO: Implement state-preserving hot-reload using the `-watch` flag and compiler cache and a websocket
serve_reactive_site = |c: Compiler, server: HttpServer, s: Site| {
    println("Serving reactive site on port " & server.port.to_str)
    server.set_handler(|req: HttpRequest| -> HttpResponse {
        // TODO: Add path normalisation
        if req.url in s.pages {
            return Html: reactive_page(c, s.pages[req.url], :Dev)
        }
        return Html: "The page " & h.escape_for_html(req.url) & " is not defined"
    })
    server.send_to_websockets(Text: "reload") // Tell clients to reload
    server.listen_and_serve()
}

