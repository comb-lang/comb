u = import "std/utils.code"

LinkedList[T] = |
    :Empty,
    NotEmpty: {head: T, tail: LinkedList[T]},
|

insert[T] = fn (list: LinkedList[T], number: T) -> LinkedList[T] {
    return NotEmpty: {head = number, tail = list}
}

reverse[T] = fn (list: LinkedList[T], end: LinkedList[T]) -> LinkedList[T] {
    match list {
        :Empty {
            return end
        }
        NotEmpty: not_empty {
            return reverse[T](not_empty.tail, NotEmpty: {head = not_empty.head, tail = end})
        }
    }
}

to_array[T] = fn (list: LinkedList[T]) -> T[] {
    re array$ = u.empty_array[T]()
    re l$ = list
    while true {
        match l$ {
            :Empty {
                return array$
            }
            NotEmpty: not_empty {
                array$ = array$ :: not_empty.head
                l$ = not_empty.tail
            }
        }
    }
}

foreach[T] = fn (list: LinkedList[T], func: (T) -> ()) {
    re l$ = list
    while true {
        match l$ {
            :Empty {
                return
            }
            NotEmpty: not_empty {
                func(not_empty.head)
                l$ = not_empty.tail
            }
        }
    }
}

empty_list[T] = fn () -> LinkedList[T] {
    return :Empty
}

debug_number = fn (number: Int) {
    println(number.to_str)
}

main = fn () -> Int {
    // TODO: Support pipe
    // l =
	//     .Empty
	//     |> insert(_, 3)
	//     |> insert(_, 2)
	//     |> insert(_, 1)
    re l$ = empty_list[Int]()
    l$ = insert[Int](l$, 3)
    l$ = insert[Int](l$, 2)
    l$ = insert[Int](l$, 1)
    for number in to_array[Int](l$) {
        println(number.to_str)
    }
    println("Reversed:")
    foreach[Int](reverse[Int](l$, :Empty), debug_number)
    return 0
}
