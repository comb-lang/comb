max_radius = 15
min_radius = 14
x_plus_y_max = 15

circle = "cc"
triangle = "tt"
nothing = "  "

main = || -> Int {
	for@outer y in -max_radius ..= max_radius {
	    for x in -max_radius ..= max_radius {
			if x + y > x_plus_y_max {
			  println(string_repeat(triangle, expect_uint(max_radius - x + 1)))
			  continue@outer
			}

		    num = x*x + y*y
			if min_radius * min_radius <= num and num <= max_radius * max_radius {
				print(circle)
				continue
			}

			print(nothing)
		}
		println("")
	}
	return 0
}
