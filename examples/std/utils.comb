// TODO: Be able to iterate over the characters in a string like `for c in string { ... }`
// You should not have to define these functions in every program you write that uses them

swap[T] = |l: T[], a: Int, b: Int| -> T[] {
	return l
		~ [a] = l[b]
		~ [b] = l[a]
}

quick_sort[T] = |l$: T[]| -> T[] {
	// TODO: Implement linear types or something so that the quick sort implementation is actually reasonably fast
	if l$.len <= 1 {
		return l$
	}
	pivot = l$[0]
	re start$ = 1
	re end$ = l$.len - 1
	while start$ < end$ {
		if l$[start$] <= pivot {
			start$ = start$ + 1
		} else {
			l$ = swap[T](l$, start$, end$)
			end$ = end$ - 1
		}
	}
	if l$[start$] <= pivot {
		start$ = start$ + 1
	}
	out = quick_sort[T](l$[1:start$]) :: pivot
	if start$ < l$.len {
		return out ++ quick_sort[T](l$[start$:l$.len])
	}
	return out

}

uint_div = |a: UInt, b: UInt| -> UInt {
	println(a.to_str & b.to_str)
	subtract = a % b
	return expect_uint((a - subtract) / b)
}

append[T] = |elem: T| -> (T[]) -> T[] {
	return |array: T[]| -> T[] {
		return array :: elem
	}
}

concat[T] = |array1: T[]| -> T[] -> T[] {
	return |array0: T[]| -> T[] {
		return array0 ++ array1
	}
}

as[T] = |v: T| -> T {
	return v
}

assert = |cond: Bool| {
	assert_with_message(cond, "Assert failed")
}

assert_with_message = |cond: Bool, message: String| {
	if cond == false {
		eprintln(message)
		unreachable
	}
}

negate = |a: Float| -> Float {
	return -a
}

pow = |a: Float, b$: UInt| -> Float {
	re out$ = 1.0
	while b$ > 0 {
	    out$ = out$ * a
		b$ = expect_uint(b$ - 1)
	}
	return out$
}

map[I, O] = |array: I[], func: (I) -> O| -> O[] {
	re out$ = empty_array[O]()
	for elem in array {
		out$ = out$ :: func(elem)
	}
	return out$
}

flat_map[I, O] = |array: I[], func: (I) -> O[]| -> O[] {
	re out$ = empty_array[O]()
	for elem in array {
		out$ = out$ ++ func(elem)
	}
	return out$
}

empty_map[T] = || -> T {
	return OrderedHashMap()
}

empty_array[T] = || -> T[] {
	return []
}

Result[O, E] = \
	Ok: O,
	Err: E,
\

map_ok[O, O2, E] = |r: Result[O, E], f: (O) -> O2| -> Result[O2, E] {
	match r {
		Ok: o {
			return Ok: f(o)
		}
		Err: e {
			return Err: e
		}
	}
}

split_first = |str: String, by: Char| -> {before: String, after: String} {
	for i in 0..<str.len {
		if str[i] == by {
			return {before = str[0:i], after = str[i+1:str.len]}
		}
	}
	return {before = str, after = ""}
}

// TODO: Maybe this could be defined like `Result[V, {}]` in the future
Maybe[V] = \
    Some: V,
	:None,
\

// TODO: Be able to implement this better
// - Be able to use `c - '0'`
// - Be able to use `'0' <= c && c <= '9'`
char_to_num = |c: Char| -> Maybe[UInt] {
	if c == '0' { return Some: 0 }
	if c == '1' { return Some: 1 }
	if c == '2' { return Some: 2 }
	if c == '3' { return Some: 3 }
	if c == '4' { return Some: 4 }
	if c == '5' { return Some: 5 }
	if c == '6' { return Some: 6 }
	if c == '7' { return Some: 7 }
	if c == '8' { return Some: 8 }
	if c == '9' { return Some: 9 }
	return :None
}

string_to_uint = |str: String| -> Result[UInt, String] {
	if str == "" {
		return Err: "Empty string"
	}
	re out$ = 0
	for i in 0..<str.len {
		match char_to_num(str[i]) {
			Some: digit {
				out$ = out$ * 10
				out$ = out$ + digit
			}
			:None {
				return Err: "Unexpected non-digit character '" & str[i:i] & "'"
			}
		}
	}
	return Ok: out$
}

string_to_float = |str: String| -> Result[Float, String] {
	if str == "" {
		return Err: "Empty string"
	}
	if str[0] == '-' {
		return map_ok[Float, Float, String](string_to_float(str[1:str.len]), negate)
	}
	if str[0] == '+' {
		return string_to_float(str[1:str.len])
	}
	split = split_first(str, '.')
	match string_to_uint(split.before) {
		Err: e {
			return Err: e
		}
		Ok: whole_part {
			if split.after == "" {
				return Ok: whole_part
			}
			match string_to_uint(split.after) {
				Err: e {
					return Err: e
				}
				Ok: fraction_part {
					return Ok: whole_part + (fraction_part / pow(10, split.after.len))
				}
			} 
		}
	}
}

