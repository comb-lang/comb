u = import "std/utils.code"

// Curried concat function
// TODO: Infer function return type
concat[T] = fn (a: T[]) -> (T[]) -> T[] {
	return fn (b: T[]) -> T[] {
		return a ++ b
	}
}

// TODO: Be able to convert arrays to strings automatically
array_to_str = fn (a: Int[]) -> String {
	re out$ = "["
	// TODO: Cleanup syntax: `out$ = out$ & ...` => something like `out &= ...`
	for elem, i in a {
		if i != 0 {
			out$ = out$ & ", "
		}
		out$ = out$ & elem.to_str
	}
	out$ = out$ & "]"
	return out$
}

main = fn () -> Int {
	my_concatanater = concat[Int]([1, 2, 3])
	result1 = my_concatanater([4, 5])
	result2 = my_concatanater([6, 7, 8, 9])
	u.assert(array_to_str(result1) == "[1, 2, 3, 4, 5]")
	u.assert(array_to_str(result2) == "[1, 2, 3, 6, 7, 8, 9]")
	return 0
}
