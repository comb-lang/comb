u = import "std/utils.comb"

// TODO: Improve the experience of testing your code:
// - Be able to see which assertion failed to cause a test to fail

TestResult = \:Passed, :Failed\
test_result_to_str = |r: TestResult| -> String {
	match r {
		:Passed { return "passed" }
		:Failed { return "failed" }
	}
}

test_quick_sort = || -> TestResult {
	unsorted = [71, 8, 2, 70, 5, 10, 3, 67]
	sorted = u.quick_sort[UInt](unsorted)
	//println("Result:")
	//for sorted_elem in sorted {
	//	println(sorted_elem.to_str)
	//}
	if sorted[0] != 2 { return :Failed }
	if sorted[1] != 3 { return :Failed }
	if sorted[2] != 5 { return :Failed }
	if sorted[3] != 8 { return :Failed }
	if sorted[4] != 10 { return :Failed }
	if sorted[5] != 67 { return :Failed }
	if sorted[6] != 70 { return :Failed }
	if sorted[7] != 71 { return :Failed }
	return :Passed
}

test_string_manipulation = || -> TestResult {
	if u.starts_with("ab", "abc") != false { return :Failed }
	if u.starts_with("abc", "abc") != true { return :Failed }
	if u.starts_with("hello world", "h") != true { return :Failed }

	if u.ends_with("ab", "dab") != false { return :Failed }
	if u.ends_with("dab", "dab") != true { return :Failed }
	if u.ends_with("hello world", "d") != true { return :Failed }
	
	return :Passed
}

test_all = || -> Int {
	println("quick_sort: " & test_result_to_str(test_quick_sort()))
	println("string_manipulation: " & test_result_to_str(test_string_manipulation()))
	return 0
}
