LinkedList[T] = <
    :Empty,
    :NotEmpty {head: T, tail: LinkedList[T]},
>

insert[T] = |list: LinkedList[T], number: T| -> LinkedList[T] {
    return :NotEmpty {head = number, tail = list}
}

reverse[T] = |list: LinkedList[T], end: LinkedList[T]| -> LinkedList[T] {
    match list {
        .Empty {
            return end
        }
        not_empty: .NotEmpty {
            return reverse[T](not_empty.tail, :NotEmpty {head = not_empty.head, tail = end})
        }
    }
}

to_array[T] = |list: LinkedList[T]| -> []T {
    re array$ = []T()
    re l$ = list
    while true {
        match l$ {
            .Empty {
                return array$
            }
            not_empty: .NotEmpty {
                array$ = array$ :: not_empty.head
                l$ = not_empty.tail
            }
        }
    }
}

foreach[T] = |list: LinkedList[T], func: (T) -> ()| {
    re l$ = list
    while true {
        match l$ {
            .Empty {
                return
            }
            not_empty: .NotEmpty {
                func(not_empty.head)
                l$ = not_empty.tail
            }
        }
    }
}

empty_list[T] = || -> LinkedList[T] {
    return :Empty
}

debug_number = |number: Int| {
    println(number.to_str)
}

main = || -> Int {
    // TODO: Support pipe
    // l =
	//     .Empty
	//     |> insert(_, 3)
	//     |> insert(_, 2)
	//     |> insert(_, 1)
    re l$ = empty_list[Int]()
    l$ = insert[Int](l$, 3)
    l$ = insert[Int](l$, 2)
    l$ = insert[Int](l$, 1)
    for number in to_array[Int](l$) {
        println(number.to_str)
    }
    println("Reversed:")
    foreach[Int](reverse[Int](l$, :Empty), debug_number)
    return 0
}
