h = import "std/html.code"
http = import "std/http.code"

game_width = 15
game_height = 15
game_size = game_height * game_width
main_title = "Conway's game of life"

count_pixel_life = |s: [game_height][game_width]Bool, x: Int, y: Int| -> UInt {
	if x < 0 or x >= game_width or y < 0 or y >= game_height {
		return 0
	}
	if s[y][x] {
		return 1
	}
	return 0
}

run_tick = |s: [game_height][game_width]Bool| -> [game_height][game_width]Bool {
    f = false
	r = [game_width]Bool(f, f, f, f, f, f, f, f, f, f, f, f, f, f, f)
    re new_state$ = [game_height][game_width]Bool(r, r, r, r, r, r, r, r, r, r, r, r, r, r, r)
    for row, y in s {
		for was_alive, x in row {
	        re surrounding_alive_pixels$ = 0

		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x-1, y-1)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x,   y-1)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x+1, y-1)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x-1, y)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x+1, y)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x-1, y+1)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x,   y+1)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x+1, y+1)

			if was_alive {
				new_state$ = new_state$ ~ [y][x] = 2 <= surrounding_alive_pixels$ and surrounding_alive_pixels$ <= 3
			} else {
				new_state$ = new_state$ ~ [y][x] = surrounding_alive_pixels$ == 3
			}
		}
    }
    return new_state$
}

game_of_life = |s: [game_height][game_width]Bool| -> h.UI {
    re grid_pixels$ = []h.HtmlElem()
    for row in s {
		for pixel in row {
	        if pixel {
		        grid_pixels$ = grid_pixels$ :: :Div {style = "background: #FFFFFF;", children = []h.HtmlElem()}
	        } else {
		        grid_pixels$ = grid_pixels$ :: :Div {style = "background: #000000;", children = []h.HtmlElem()}
	        }
		}
    }
	grid_style =
        "display: grid;"
        "grid-template-columns: repeat(" & game_width.to_str & ", 1fr);"
        "aspect-ratio: 1 / 1;"
	ui_contents = []h.HtmlElem(
        :Button {
			children = []h.HtmlElem(:Text "Run tick"),
			onclick = || -> h.UI { return game_of_life(run_tick(s)) },
		},
        :Div {style = grid_style, children = grid_pixels$},
    )
	return {
		page_title = main_title,
		ui_contents = ui_contents,
		on_key_down = |_: h.Key| -> h.UI { return game_of_life(s) },
	}
}

pulsar_initial_state = [game_height][game_width]Bool(
    [game_width]Bool(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false),
    [game_width]Bool(false, false, false, true,  true,  true,  false, false, false, true,  true,  true,  false, false, false),
    [game_width]Bool(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false),
    [game_width]Bool(false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false),
    [game_width]Bool(false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false),
    [game_width]Bool(false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false),
    [game_width]Bool(false, false, false, true,  true,  true,  false, false, false, true,  true,  true,  false, false, false),
    [game_width]Bool(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false),
    [game_width]Bool(false, false, false, true,  true,  true,  false, false, false, true,  true,  true,  false, false, false),
    [game_width]Bool(false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false),
    [game_width]Bool(false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false),
    [game_width]Bool(false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false),
    [game_width]Bool(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false),
    [game_width]Bool(false, false, false, true,  true,  true,  false, false, false, true,  true,  true,  false, false, false),
    [game_width]Bool(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false),
)

site = {pages = OrderedHashMap[String, () -> h.UI][
	"/" = || -> h.UI { return game_of_life(pulsar_initial_state) },
]}

build = |c: Compiler| -> Int {
	h.build_reactive_site(c, site, "gitignore_conways_game_of_life")
    return 0
}

// TODO: Add unit test for this
serve = |c: Compiler| -> Int {
	server = http.get_http_server(c.cache, "server")
    h.serve_reactive_site(c, server, site)
	return 0
}
