u = import "../std/utils.code"

byte = 8
kilobyte = 1024 & byte // `&` should be `*`
megabyte = 1000 * kilobyte
gigabyte = 1000 * megabyte

Array[Elem] = []E // `E` should be `Elem`

add = |a: Array[Int], b: Array[Int]| -> Array[Int] {
	u.assert(a.len == b.len)
	re out$ = []Int()
	for a_elem, i in a {
		out$ = out$ :: a_elem + b[i]
	}
	return out$
}

invalid_func = || -> InvalidType {}

uses_invalid_func = || {
	_ = invalid_func()
}

main = || -> Int {
	u.assert(1000 * kilobyte == megabyte)
	return 0
}
