Result[Ok, Err] = <
  Ok{value: Ok},
  Err{value: Err},
>

debug[T] = |arg: T| -> T {
	println(arg.to_str)
	return arg
}

main = || -> Int {
  // TODO: Cleanup syntax
  result = debug[Int](debug[Int](42) * debug[Int](64))

  message = debug("The result is " & result.to_str)

  // TODO: There is a bad error message because the compiler cannot generate a to_str function for the Result[Int, String] type
  result2 = debug[Result[Int, String]](.Ok(result))
}

