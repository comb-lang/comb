h = import "std/html.comb"
http = import "std/http.comb"

CounterState = {
    count: UInt,
}

counter_initial_state = {count = 1}

increment_count = |s: CounterState, g: h.EmptyGlobalState| -> h.State[CounterState, h.EmptyGlobalState] {
	return {state = {count = s.count + 1}, global_state = g}
}

counter = |s: CounterState, _g: h.EmptyGlobalState| -> h.UI[CounterState, h.EmptyGlobalState] {
    contents = [
        Button: {
            children = [Text: ("The count is " & s.count.to_str)],
            onclick = increment_count,
        },
    ]
    return {
        page_title = "Counter",
        ui_contents = contents,
    }
}

site = {
    initial_global_state = h.empty_global_state,
    pages = OrderedHashMap(
        "/" = scope(h.Page[Scoped, h.EmptyGlobalState], CounterState, {
            state = |s: String| -> CounterState {
                return deserialize_from_json[CounterState](s, counter_initial_state)
            },
            serialize_state = |s: CounterState| -> String {
                return serialize_to_json(to_typed[CounterState](s))
            },
            render = counter,
            on_key_down = h.ignore_keypress[CounterState, h.EmptyGlobalState],
        }),
    ),
}

build = |c: Compiler| -> Int {
    h.build_reactive_site[h.EmptyGlobalState](c, site, "gitignore_counter")
    return 0
}

// TODO: Add unit test for this
serve = |c: Compiler| -> Int {
    server = http.get_http_server(c.cache, "server")
    h.serve_reactive_site[h.EmptyGlobalState](c, server, site)
    return 0
}
