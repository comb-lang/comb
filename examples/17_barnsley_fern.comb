// TODO: Be able to write `to_int` in a cleaner way
delta_truncate = |n: Float| -> Float {
	if n < 0 {
		return (-n) % 1
	}
	return -(n % 1)
}
to_int = |v: Float| -> Int {
	whole = v + delta_truncate(v)
	if whole < 0 {
		return -(expect_uint(-whole))
	} else {
		return expect_uint(whole)
	}
}

main = |p: (String) -> ()| -> Int {
	re point$ = {x = 0.0, y = 0.0}
	re image$ = u.as[Image](initial_image)
	for _ in 1 ..= 50000 {
		point$ = affine_transform(point$, get_affinte_transform())
		x = to_int(point$.x * 50) + 250
		y = to_int(point$.y * 50)
		if 0 <= x and x < 500 and 0 <= y and y < 500 {
			image$ = image$ ~ [y][x] = true
		} else {
			println("Out of range")
		}
	}
	for row in image$ {
		for cell in row {
			if cell {
				p("X")
			} else {
				p(" ")
			}
		}
		println("")
	}
	return 0
}

file_path = #abs "gitignore_barnsly_fern.js"

build = |c: Compiler| -> Int {
	// TODO: Update the code emitted by `print` so it uses `process.stdout.write` when available to avoid printing newlines
	code = c.emit_js_code(OrderedHashMap("f" = main), "f((str) => process.stdout.write(str))")
	write_file(file_path, code)
	return 0
}

run = |c: Compiler| -> Int {
	status = build(c)
	if status != 0 {
		return status
	}
	return run_executable({working_dir = ".", command = ["bun", "run", file_path]})
}
