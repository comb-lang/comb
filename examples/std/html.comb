//                                           Implemented in the programming language
//                                                         |--|
//                                                         |  |
//            state -> ui -> html -> event -> state updater -> new state
//                 |  |  |                   |
//                 |  |  |-------------------|
//                 |  |    Implemented in JS
//                 |--|
// Implemented in the programming language 
// State serialisation and deserialisation is only used for preserving state on hot reload

t = import "time.comb"
h = import "http.comb"
p = import "path.comb"
u = import "utils.comb"

SvgElem = \
    Line: {
        x1: UInt,
        y1: UInt,
        x2: UInt,
        y2: UInt,

        stroke_width: UInt,
        stroke_color: String,
    },
\

HtmlElem[GlobalState] = \
    Button: {children: HtmlElem[GlobalState][], onclick: State[GlobalState]},
    Div: {style: String, children: HtmlElem[GlobalState][]},
    Text: String,
    Span: String,
    Svg: {style: String, width: UInt, height: UInt, contents: SvgElem[]},
    :Br,
    Select: {
        style: String,
        options: {
            label: String,
            on_select: State[GlobalState],
        }[],
    },
\

Key = {
    key: String,
}

UI[GlobalState] = {
    page_title: String,
    ui_contents: HtmlElem[GlobalState][],
    on_key_down: (Key) -> State[GlobalState],
}

RenderInfo = {
    date: t.Date,
}

StateWithoutGlobalState[GlobalState] = {
    render: (GlobalState, RenderInfo) -> UI[GlobalState],
    serialize: () -> String,
}

State[GlobalState] = {
    global_state: GlobalState,
    other_state: StateWithoutGlobalState[GlobalState]
}

EmptyGlobalState = \:None\ // TODO: Be able to use `{:}`
empty_global_state = :None // TODO: Be able to use `{=}`

Site[GlobalState] = {
    initial_global_state: GlobalState,
    // The string passed in is the serialized state
    pages: OrderedHashMap[String, (String) -> StateWithoutGlobalState[GlobalState]], // TODO: Be able to use an unordered hash map
}

html_page = |js: String| -> String {
    // The close tags are split up so that the browser interprets them as JS strings rather than HTML close tags
	// TODO: JS should be tree-shaked so the `html_page` function shouldn't even be included in the emitted JS code
    return
        "<!DOCTYPE html>" &
        "<html lang=\"en\">" &
            "<head>" &
                "<meta charset=\"UTF-8\" />" &
                "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">" &
                "<script>" & js & "</" & "script>" &
            "</" & "head>" &
            "<body></" & "body>" &
        "</" & "html>"   
}

base_js = #load "./js/base.js"

// Expects a `state` global of type `State[GlobalState]`
prod_js = base_js & #load "./js/static.js"

// Expects a `code.js` file
reload_js = #load "./js/reload.js"

build_reactive_site[GlobalState] = |c: Compiler, s: Site[GlobalState], path: String| {
    for rel_page_path, ui in s.pages {
        page_path = path & "/" & p.normalize_path(rel_page_path) & ".html"
        make_dir_all(p.dir(page_path))
        // TODO: Be able to define the map something like `{"ui": ui()}`
        map = OrderedHashMap("state" = {
            global_state = s.initial_global_state,
            other_state = ui(""),
        })
        // TODO: Add minification:
        // - Maybe there could be an argument with the type
        //   `\:Minify, :LeaveNames\` in the future
        // - Alternatively, named arguments and default arguments could be added so
        //   the type of emit_js_code is
        //   `(OrderedHashMap[String, Any], String, minify = true)`, and then you
        //   call it like `emit_js_code(map, glue, minify = true)`
        js = c.emit_js_code(map, prod_js)
        write_file(page_path, html_page(js))
    }
}

// TODO: Implement state-preserving hot-reload using the `-watch` flag and compiler cache and a websocket
serve_reactive_site[GlobalState] = |c: Compiler, server: HttpServer, s: Site[GlobalState]| {
    println("Serving reactive site on port " & server.port.to_str)
    html = html_page(reload_js)
    server.set_handler(|req: HttpRequest| -> HttpResponse {
        println("Handling request for " & req.url)
        // TODO: Add path normalisation
        if req.url in s.pages {
            return Html: html
        }
        match u.try_remove_end(req.url, "code.js") {
            Some: page_path {
                if page_path in s.pages {
                    map = OrderedHashMap(
                        "state_from_serialized" = s.pages[page_path],
                        "initial_global_state" = s.initial_global_state,
                    )
                    return Js: c.emit_js_code(map, base_js)
                }
            }
            :None {}
        }
        return Html: "The page " & h.escape_for_html(req.url) & " is not defined"
    })
    server.send_to_websockets(Text: "reload") // Tell clients to reload
    server.listen_and_serve()
}

