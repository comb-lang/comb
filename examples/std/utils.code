// TODO: Include these utils in some standard library
// You should not have to define `assert` in every program you write that uses assert
assert = |cond: Bool| {
	if cond == false {
		unreachable
	}
}

assert_with_message = |cond: Bool, message: String| {
	if cond == false {
		eprintln(message)
		unreachable
	}
}

