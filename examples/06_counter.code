h = import "std/html.code"
http = import "std/http.code"

CounterState = {
    count: UInt,
}

counter_initial_state = {count = 1}

increment_count = fn (s: CounterState) -> CounterState {
	return {count = s.count + 1}
}

counter = fn (s: CounterState) -> h.UI {
    contents = [
        Button: {
            children = [Text: ("The count is " & s.count.to_str)],
            onclick = fn () -> h.UI { return counter(increment_count(s)) }, // TODO: Cleanup syntax
        },
    ]
    return {
        page_title = "Counter",
        ui_contents = contents,
        on_key_down = fn (_: h.Key) -> h.UI {return counter(s)},
    }
}

site = {pages = OrderedHashMap(
    "/" = fn () -> h.UI {return counter(counter_initial_state)},
)}

build = fn (c: Compiler) -> Int {
    h.build_reactive_site(c, site, "gitignore_counter")
    return 0
}

// TODO: Add unit test for this
serve = fn (c: Compiler) -> Int {
    server = http.get_http_server(c.cache, "server")
    h.serve_reactive_site(c, server, site)
    return 0
}
