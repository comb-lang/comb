h = import "std/html.comb"
http = import "std/http.comb"

CounterState = {
    count: UInt,
}

counter_initial_state = {count = 1}

increment_count = |s: CounterState| -> CounterState {
	return {count = s.count + 1}
}

counter = |s: CounterState| -> h.UI[h.EmptyGlobalState] {
    contents = [
        Button: {
            children = [Text: ("The count is " & s.count.to_str)],
            onclick = {
                global_state = h.empty_global_state,
                other_state = counter2(increment_count(s)), // TODO: Cleanup syntax
            },
        },
    ]
    return {
        page_title = "Counter",
        ui_contents = contents,
        on_key_down = |_: h.Key| -> h.State[h.EmptyGlobalState] {
            return {
                global_state = h.empty_global_state,
                other_state = counter2(s)
            }
        },
    }
}

counter2 = |s: CounterState| -> h.StateWithoutGlobalState[h.EmptyGlobalState] {
    return {
        render = |_state: h.EmptyGlobalState, _info: h.RenderInfo| -> h.UI[h.EmptyGlobalState] {
            return counter(s)
        },
        serialize = || -> String {
            return serialize_to_json[CounterState](s)
        },
    }
}

site = {
    initial_global_state = h.empty_global_state,
    pages = OrderedHashMap(
        "/" = |old_state: String| -> h.StateWithoutGlobalState[h.EmptyGlobalState] {
			state = deserialize_from_json[CounterState](old_state, counter_initial_state)
            return counter2(state)
        },
    ),
}

build = |c: Compiler| -> Int {
    h.build_reactive_site[h.EmptyGlobalState](c, site, "gitignore_counter")
    return 0
}

// TODO: Add unit test for this
serve = |c: Compiler| -> Int {
    server = http.get_http_server(c.cache, "server")
    h.serve_reactive_site[h.EmptyGlobalState](c, server, site)
    return 0
}
