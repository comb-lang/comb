h = import "std/html.comb"
http = import "std/http.comb"
u = import "std/utils.comb"

game_width = 15
game_height = 15
game_size = game_height * game_width
main_title = "Conway's game of life"

Column = {
	cells: Bool[]
}

State = {
	rows: Column[]
}

count_pixel_life = |s: State, x: Int, y: Int| -> UInt {
	if x < 0 or x >= game_width or y < 0 or y >= game_height {
		return 0
	}
	if s.rows[y].cells[x] {
		return 1
	}
	return 0
}

run_tick = |s: State| -> State {
    f = false
	r = {cells = [f, f, f, f, f, f, f, f, f, f, f, f, f, f, f]}
    re new_state$ = {rows = [r, r, r, r, r, r, r, r, r, r, r, r, r, r, r]}
    for row, y in s.rows {
		for was_alive, x in row.cells {
	        re surrounding_alive_pixels$ = 0

		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x-1, y-1)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x,   y-1)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x+1, y-1)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x-1, y)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x+1, y)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x-1, y+1)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x,   y+1)
		    surrounding_alive_pixels$ = surrounding_alive_pixels$ + count_pixel_life(s, x+1, y+1)

			if was_alive {
				new_state$ = new_state$ ~ .rows[y].cells[x] = 2 <= surrounding_alive_pixels$ and surrounding_alive_pixels$ <= 3
			} else {
				new_state$ = new_state$ ~ .rows[y].cells[x] = surrounding_alive_pixels$ == 3
			}
		}
    }
    return new_state$
}

game_of_life2 = |s: State| -> h.StateWithoutGlobalState[h.EmptyGlobalState] {
    return {
        render = |_state: h.EmptyGlobalState, _info: h.RenderInfo| -> h.UI[h.EmptyGlobalState] {
            return game_of_life(s)
        },
        serialize = || -> String {
            return serialize_to_json[State](s)
        },
    }
}

game_of_life = |s: State| -> h.UI[h.EmptyGlobalState] {
    re grid_pixels$ = u.empty_array[h.HtmlElem[h.EmptyGlobalState]]()
    for row in s.rows {
		for pixel in row.cells {
	        if pixel {
		        grid_pixels$ = grid_pixels$ :: Div: {style = "background: #FFFFFF;", children = []}
	        } else {
		        grid_pixels$ = grid_pixels$ :: Div: {style = "background: #000000;", children = []}
	        }
		}
    }
	grid_style =
        "display: grid;" &
        "grid-template-columns: repeat(" & game_width.to_str & ", 1fr);" &
        "aspect-ratio: 1 / 1;"
	ui_contents = [
        Button: {
			children = [Text: "Run tick"],
			onclick = {
				global_state = h.empty_global_state,
				other_state = game_of_life2(run_tick(s))
			},
		},
        Div: {style = grid_style, children = grid_pixels$},
    ]
	return {
		page_title = main_title,
		ui_contents = ui_contents,
		on_key_down = |_: h.Key| -> h.State[h.EmptyGlobalState] {
			return {
				global_state = h.empty_global_state,
				other_state = game_of_life2(s)
			}
		},
	}
}

pulsar_initial_state = {rows = [
    {cells = [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false]},
    {cells = [false, false, false, true,  true,  true,  false, false, false, true,  true,  true,  false, false, false]},
    {cells = [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false]},
    {cells = [false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false]},
    {cells = [false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false]},
    {cells = [false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false]},
    {cells = [false, false, false, true,  true,  true,  false, false, false, true,  true,  true,  false, false, false]},
    {cells = [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false]},
    {cells = [false, false, false, true,  true,  true,  false, false, false, true,  true,  true,  false, false, false]},
    {cells = [false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false]},
    {cells = [false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false]},
    {cells = [false, true,  false, false, false, false, true,  false, true,  false, false, false, false, true,  false]},
    {cells = [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false]},
    {cells = [false, false, false, true,  true,  true,  false, false, false, true,  true,  true,  false, false, false]},
    {cells = [false, false, false, false, false, false, false, false, false, false, false, false, false, false, false]},
]}

site = {
	initial_global_state = h.empty_global_state,
	pages = OrderedHashMap(
		"/" = |old_state: String| -> h.StateWithoutGlobalState[h.EmptyGlobalState] {
			state = deserialize_from_json[State](old_state, pulsar_initial_state)
			return game_of_life2(state)
		},
	)
}

build = |c: Compiler| -> Int {
	h.build_reactive_site[h.EmptyGlobalState](c, site, "gitignore_conways_game_of_life")
    return 0
}

// TODO: Add unit test for this
serve = |c: Compiler| -> Int {
	server = http.get_http_server(c.cache, "server")
    h.serve_reactive_site[h.EmptyGlobalState](c, server, site)
	return 0
}
