u = import "std/utils.comb"

Point = {x: Float, y: Float}
Matrix = {top_left: Float, top_right: Float, bottom_left: Float, bottom_right: Float}
AffineTransform = {scale: Matrix, translate: Point}

affine_transform = |point: Point, t: AffineTransform| -> Point {
	return {
		x = (point.x * t.scale.top_left) + (point.y * t.scale.top_right) + t.translate.x,
		y = (point.x * t.scale.bottom_left) + (point.y * t.scale.bottom_right) + t.translate.y,
	}
}

get_affinte_transform = || -> AffineTransform {
    p = random_float()
	if p < 0.01 {
		return {
			scale = {top_left = 0, top_right = 0, bottom_left = 0, bottom_right = 0.16},
			translate = {x = 0, y = 0},
		}
	} else if p < 0.86 {
		return {
			scale = {top_left = 0.85, top_right = 0.04, bottom_left = -0.04, bottom_right = 0.85},
			translate = {x = 0, y = 1.6},
		}
	} else if p < 0.93 {
		return {
			scale = {top_left = 0.2, top_right = -0.26, bottom_left = 0.23, bottom_right = 0.22},
			translate = {x = 0, y = 1.6},
		}
	} else {
		return {
			scale = {top_left = -0.15, top_right = 0.28, bottom_left = 0.26, bottom_right = 0.24},
			translate = {x = 0, y = 0.44},
		}
	}
}

